{
  "name": "prompt-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source one-key prompt enhancement engine — CLI + MCP server + playground",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/core/test/*.test.js packages/providers/test/*.test.js packages/cli/test/*.test.js packages/mcp-server/test/*.test.js",
    "bench": "node packages/core/bench/bench.js",
    "eval": "node eval/run.mjs",
    "mock": "node mock/server.js",
    "playground": "node packages/playground/serve.js"
  }
}
